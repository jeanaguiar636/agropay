{
  "name": "agropay",
  "version": "1.0.0",
  "private": true,
  "description": "AgroPay / AgroTrade VIP — simulador educativo de negociação de commodities (Cloudflare Workers + D1)",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create agropay-db",
    "db:migrate:local": "wrangler d1 migrations apply agropay-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply agropay-db --remote",
    "test": "node --test tests/*.test.js"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
